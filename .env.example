# =============================================================================
# JoJo Tracker — configuration (copier en .env : `cp .env.example .env`)
# Générer un secret :  openssl rand -base64 32 | tr -d '/+='
# =============================================================================

# --- Application ---------------------------------------------------------------
# URL publique EXACTE de l'appli (schéma + domaine, sans slash final).
# Sert à la protection CSRF (vérification de l'en-tête Origin) : doit correspondre
# à l'adresse tapée dans le navigateur.
APP_ORIGIN=https://jojo.example.com

# Adresse et port publiés sur l'hôte (le reverse proxy pointe ici).
# Laisser 127.0.0.1 si le reverse proxy tourne sur la même machine.
APP_BIND=127.0.0.1
APP_PORT=3000

# Cookie de session « Secure » (HTTPS uniquement). Laisser true derrière un proxy HTTPS.
# Ne passer à false que pour un test local en http://.
COOKIE_SECURE=true

# Proxies de confiance pour lire la vraie IP (X-Forwarded-For) : utile au rate limiting.
# Valeur par défaut adaptée à un proxy local ou dans un conteneur voisin.
TRUST_PROXY=loopback,linklocal,uniquelocal

# --- Inscriptions -------------------------------------------------------------
# false : plus personne ne peut créer de compte (l'écran d'inscription l'indique).
ALLOW_SIGNUP=true
# Optionnel : si défini (6 caractères minimum), ce code est exigé à l'inscription.
# Exemple : openssl rand -base64 18
INVITE_CODE=

# --- Sessions -----------------------------------------------------------------
# Durée (jours, glissante) d'une session « rester connectée ».
SESSION_TTL_DAYS=30

# --- Base de données ----------------------------------------------------------
POSTGRES_USER=jojo
# OBLIGATOIRE : openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=jojo
# Optionnel : URL complète, prioritaire sur les variables ci-dessus.
# Par défaut construite automatiquement : postgres://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
DATABASE_URL=

# --- Journalisation -----------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
